{
  "name": "@vowlabs/banking",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./banking": {
      "types": "./dist/sdk/banking.d.ts",
      "default": "./dist/sdk/banking.js"
    },
    "./burn": {
      "types": "./dist/sdk/burn.d.ts",
      "default": "./dist/sdk/burn.js"
    },
    "./staking": {
      "types": "./dist/sdk/staking.d.ts",
      "default": "./dist/sdk/staking.js"
    },
    "./watch": {
      "types": "./dist/sdk/watch.d.ts",
      "default": "./dist/sdk/watch.js"
    },
    "./utils": {
      "types": "./dist/sdk/utils/index.d.ts",
      "default": "./dist/sdk/utils/index.js"
    },
    "./unit-onboarding": {
      "types": "./dist/lib/unit-onboarding/index.d.ts",
      "default": "./dist/lib/unit-onboarding/index.js"
    }
  },
  "scripts": {
    "test": "vitest --run",
    "test:debug": "node --inspect-brk ./node_modules/vitest/vitest.mjs run --threads=false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "verify": "npm audit --audit-level=high && npm test && npm run typecheck && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run verify"
  },
  "files": [
    "dist",
    "public",
    "README.md"
  ],
  "dependencies": {
    "axios": "^1.19.0",
    "ethers": "^6.17.0",
    "react": "^19"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
